# M&B Atelier — Production Environment Variables Configuration Template
# =====================================================================
# Copy this file to .env for local development or set these variables
# in your production hosting platform (e.g., Cloud Run, Vercel, VPS).
# NEVER commit the actual .env file with real secrets to source control.

# Application Server & Public URL
NODE_ENV="production"
PORT=3000
APP_URL="https://mbatelier.shop"
TRUSTED_ORIGINS="https://mbatelier.shop,http://localhost:3000"

# Server-Side Cryptographic Secrets (MUST be generated via cryptographically strong RNG)
# Example: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_64_CHARS_RANDOM_SECRET_FOR_SESSIONS"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_64_CHARS_RANDOM_SECRET_FOR_JWT_SIGNING"

# Initial Administrator Bootstrap Credentials
# Required to bootstrap the first administrator safely on startup
ADMIN_BOOTSTRAP_EMAIL="admin@mbatelier.shop"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_INITIAL_STRONG_ADMIN_PASSWORD_MIN_16_CHARS"

# Administrative Route Obfuscation Gateway
# Obfuscated route token for admin gateway access
GATEWAY_SECRET_TOKEN="gateway-portal-x99"

# Transactional SMS / WhatsApp OTP Delivery Provider Configuration
# Supported providers: "disabled" (development error/manual), "twilio", or "custom_gateway"
SMS_PROVIDER="disabled"
SMS_API_KEY="YOUR_SMS_GATEWAY_API_KEY_HERE"
SMS_API_SECRET="YOUR_SMS_GATEWAY_API_SECRET_HERE"
SMS_SENDER_ID="MBAtelier"

# Transactional Email Provider (SMTP or API)
# Required for Email OTP and Order Confirmation notifications
EMAIL_PROVIDER="disabled"
SMTP_HOST="smtp.provider.com"
SMTP_PORT=587
SMTP_USER="notifications@mbatelier.shop"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD_HERE"

# Courier Logistics API Credentials (Server-Side Only)
# Leave blank or set to your actual carrier account keys
TRAX_API_KEY="YOUR_TRAX_API_KEY_HERE"
TRAX_ACCOUNT_NUMBER="YOUR_TRAX_ACCOUNT_NUMBER_HERE"
CALLCOURIER_API_KEY="YOUR_CALLCOURIER_API_KEY_HERE"
POSTEX_API_TOKEN="YOUR_POSTEX_API_TOKEN_HERE"
TCS_API_KEY="YOUR_TCS_API_KEY_HERE"
